{
  "$schema": "./cloudflare/node_modules/wrangler/config-schema.json",
  "name": "mke-premium-flooring-recovered-preview",
  "main": "workers/cloudflare-preview.ts",
  "compatibility_date": "2026-08-12",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/cloudflare-preview",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/__preview",
      "/__preview/*",
      "/office",
      "/office/*"
    ]
  },
  "vars": {
    "PREVIEW_MODE": "sealed"
  }
}
